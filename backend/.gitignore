# Dependencies
node_modules/
package-lock.json # Or yarn.lock, pnpm-lock.yaml if you use those

# Environment variables - Keep sensitive information out of Git
.env
.env.local
.env.development
.env.test
.env.production
.env.*.local

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Runtime data / Build output
build/
dist/
.cache/
out/

# Uploads folder (if you store user uploads locally and don't want to version them)
uploads/ # Or whatever your upload directory is named

# IDE & Editor specific files
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/launch.json
!.vscode/extensions.json
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.swp
*.swo
.history/ # VSCode local history

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Test coverage
coverage/
.nyc_output/
*.lcov

# TypeScript cache
*.tsbuildinfo

# Optional npm cache directory
.npm

# Optional REPL history
.node_repl_history

# Output of 'npm pack'
*.tgz

# Yarn Integrity file (if using Yarn)
.yarn-integrity

# Yarn v2+
.yarn/cache
.yarn/unplugged
.yarn/build-state.yml
.yarn/install-state.gz
.pnp.*

# Temporary files and folders
tmp/
temp/
*.tmp
*.temp






